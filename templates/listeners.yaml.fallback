# Fallback ONLY — used if the build-time boot did not generate
# plugins/EaglercraftXServer/listeners.yaml. entrypoint.sh patches
# listener_list[0].inject_address to 0.0.0.0:$PORT at startup.
#
# NOTE: EaglercraftXServer fills in any missing keys with its own defaults on
# load, so this minimal block is intentionally small. If the plugin logs a
# config error, deploy once, copy the generated listeners.yaml it writes, and
# commit it as a richer fallback.
listener_list:
- listener_name: eagler
  inject_address: 0.0.0.0:25577   # overwritten at runtime
  forward_ip: true
  forward_ip_header: X-Forwarded-For
  dual_stack: false
